# The settings the deploy script writes to /etc/sandcage/sandcage.env (root, mode 600).
# This is only a template: never put a real code or key in a file inside the repository.
# The model key is NOT here: it lives in its own file (SANDCAGE_LLM_KEY_FILE below).

# Public site: a domain, or <ip-with-dashes>.sslip.io; a contact address for certificate notices.
SITE_ADDRESS=
ACME_EMAIL=

# Demo protection. DEMO_ACCESS_CODE must be 12 or more characters (the API refuses to start otherwise).
DEMO_ACCESS_CODE=
DEMO_PAUSED=false
DEMO_MAX_CONCURRENT_RUNS=2
DEMO_RUNS_PER_IP_PER_HOUR=3
DEMO_RUNS_PER_DAY=40
DEMO_RUN_TOKEN_CAP=60000
DEMO_DAY_TOKEN_CAP=2000000

# Model provider (Vultr Serverless Inference). LLM_PROVIDER=scripted is for local rehearsals only.
LLM_PROVIDER=vultr
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_RETRIES=2
SANDCAGE_LLM_KEY_FILE=/etc/sandcage/llm-api-key

# Sandbox runtime: runsc (gVisor, checked with a real probe) or runc (plain Docker).
SANDBOX_RUNTIME=runsc

# Machine values the script fills in.
DOCKER_GID=
SANDCAGE_WORK_DIR=/var/lib/sandcage/work
SANDCAGE_DATA_DIR=/var/lib/sandcage/data
